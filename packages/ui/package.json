{
  "name": "@guillxume/ui",
  "version": "0.3.1",
  "description": "React design system for internal tools: shadcn/ui primitives, a full-featured DataTable, app shell and themes.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guillxume/datasheet-studio.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "!src/**/*.stories.tsx",
    "!src/**/__tests__",
    "!src/stories",
    "!src/test-setup.ts",
    "postcss.config.mjs"
  ],
  "exports": {
    "./styles/base.css": "./src/styles/base.css",
    "./themes/*": "./src/themes/*",
    "./postcss.config": "./postcss.config.mjs",
    "./components/mobile-nav": {
      "types": "./dist/components/mobile-nav/index.d.ts",
      "default": "./dist/components/mobile-nav/index.js"
    },
    "./components/scanner-input": {
      "types": "./dist/components/scanner-input/index.d.ts",
      "default": "./dist/components/scanner-input/index.js"
    },
    "./components/_internal/*": null,
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./hooks/__internal__/*": null,
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p .storybook",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "prepack": "tsdown",
    "check:dist": "node scripts/check-dist.mjs",
    "check:package": "publint && node scripts/check-types.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@bwip-js/browser": "^4.10.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@zxing/browser": "0.2.0",
    "@zxing/library": "^0.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "0.563.0",
    "motion": "^12.34.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.2",
    "react-pdf": "^11.0.0",
    "recharts": "3.7.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "use-mask-input": "^3.6.1",
    "vaul": "1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@bekaert-dev/biome-config": "^0.1.1",
    "@biomejs/biome": "2.3.14",
    "@storybook/addon-a11y": "^10.3.0",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/postcss": "^4.1.0",
    "@tanstack/react-table": "^9.2.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.1.0",
    "next": "^16.1.6",
    "nuqs": "2.8.8",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "shadcn": "^3.8.5",
    "sonner": "^2.0.7",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.1.18",
    "tsdown": "0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9.2.6",
    "next": ">=15.0.0",
    "nuqs": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
