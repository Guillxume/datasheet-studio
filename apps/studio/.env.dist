# Environnement pour `pnpm dev` / `pnpm migrate` LANCES SUR L'HOTE.
#
# A copier en apps/studio/.env. Les dependances tournent dans Docker (voir
# infra/docker-compose.dev.yml) et sont publiees sur des ports non standards,
# d'ou localhost et non les noms de service Docker.
#
# La demonstration complete (`docker compose up` a la racine) n'a pas besoin de
# ce fichier : docker-compose.yml porte sa propre configuration.

DATABASE_URL=postgres://studio:studio@localhost:5433/datasheet_studio
GOTENBERG_URL=http://localhost:3100
MAX_REQUEST_BYTES=33554432
# Retention du journal de rendus, en jours. 0 conserve tout.
#
# render_logs recoit UNE LIGNE PAR RENDU et n'avait aucune limite : un parc qui
# genere en masse en produit des centaines de milliers par mois. La page
# /journal purge au fil de l'eau ; `pnpm purge` va au bout en une fois.
RENDER_LOG_RETENTION_DAYS=90
# Retention des tentatives de connexion echouees, en jours. 0 conserve tout.
#
# Plus courte que celle du journal de rendus : une tentative ne sert qu'a
# constater une attaque en cours ou recente. Voir db/migrations/005.
LOGIN_ATTEMPT_RETENTION_DAYS=30



# --- Comptes du Studio -------------------------------------------------------
#
# En developpement, le cookie de session doit rester lisible en HTTP : sans
# COOKIE_SECURE=false, le navigateur accepte le Set-Cookie et ne le renvoie
# jamais — on boucle sur /connexion sans message d'erreur.
COOKIE_SECURE=false

# Base des liens d'activation imprimes par `pnpm admin`.
STUDIO_PUBLIC_URL=http://localhost:3000

# --- Courriel ---------------------------------------------------------------
#
# EN LOCAL, LE COURRIEL EST ATTRAPE, PAS ENVOYE. `infra/docker-compose.dev.yml`
# publie un Mailpit : SMTP sur 1025, interface sur 8025.
#
#   open http://localhost:8025
#
# `localhost` et non le nom de service `mailpit` : Next tourne sur l'HOTE en
# developpement, il ne voit pas le reseau Docker interne.
#
# On y gagne de LIRE les invitations et les reinitialisations telles qu'elles
# partiront, mise en page comprise — ce que le mode « log » ne montre pas.
MAIL_TRANSPORT=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=Datasheet Studio <no-reply@studio.localhost>

# Sans conteneur d'attrapage, mettre MAIL_TRANSPORT=log : les messages sont
# ecrits dans la console de `pnpm dev` et le lien d'activation s'affiche de
# toute facon dans /admin/comptes.
# Certificat TLS du relais non verifiable — UN SEUL usage legitime : un relais
# interne auto-signe, sur un reseau de confiance. Sur un relais joignable depuis
# Internet, cela revient a accepter n'importe quel interlocuteur.
# MAIL_TLS_INSECURE=false


# Rendus simultanes. La contrainte est la MEMOIRE tenue par les requetes en vol
# (environ trois fois le poids du payload chacune), pas la capacite de Chromium.
# Au-dela de la file, le Studio repond 429 avec Retry-After : la generation en
# masse cote boutique sait reprendre. Voir src/lib/renderQueue.ts.
MAX_CONCURRENT_RENDERS=4
MAX_QUEUED_RENDERS=8
RENDER_QUEUE_TIMEOUT_MS=20000

# --- Collecteurs (clients du Studio, voir collectors/README.md) ---------------
#
# Lues par `pnpm collect:csv|medusa|api`, qui chargent ce fichier comme les
# autres scripts hors runtime Next. Sans elles, il faut passer --studio-url et
# --studio-key a chaque appel.
#
# STUDIO_URL pointe sur le Studio LUI-MEME, pas sur la base : c'est un client
# HTTP, il n'ouvre aucune connexion Postgres.
STUDIO_URL=http://localhost:3000
# Emise par : pnpm issue-key <slug-boutique>
# ATTENTION : rejouer cette commande FAIT TOURNER la cle et invalide l'ancienne.
STUDIO_KEY=

# --- Mots de passe compromis -------------------------------------------------
#
# Le mot de passe CHOISI est confronte aux fuites de donnees connues, par
# k-anonymat : seuls les CINQ PREMIERS caracteres de son empreinte SHA-1 sont
# envoyes a api.pwnedpasswords.com, jamais le mot de passe ni son empreinte
# complete. Voir src/lib/pwnedPassword.ts et docs/comptes-et-roles.md §11.
#
# Le controle ECHOUE OUVERT : service injoignable, mot de passe accepte.
#
# `off` le desactive — sur un reseau sans acces sortant, par exemple. Autre
# possibilite : pointer PWNED_API_URL sur une copie auto-hebergee du jeu de
# donnees, que HIBP publie en telechargement. Le contrat est le meme.
PWNED_PASSWORDS=on
# PWNED_API_URL=https://api.pwnedpasswords.com

# Devis des books depuis un ERP Dolibarr (facultatif, voir src/lib/erpQuote.ts).
# Les deux vides : seul le PDF televerse est propose. La cle est celle d'un
# utilisateur Dolibarr DEDIE au Studio, en lecture des propositions commerciales.
# DOLIBARR_API_URL=https://erp.example.com/api/index.php
# DOLIBARR_API_KEY=
