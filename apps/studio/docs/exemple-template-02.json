                    ],
                    "right": [
                        {
                            "type": "SchemaImage",
                            "props": {
                                "id": "schemaimage-16",
                                "source": "{{schema_image.src}}",
                                "width": 100,
                                "align": "center"
                            }
                        }
                    ],
                    "third": []
                }
            }
        ]
